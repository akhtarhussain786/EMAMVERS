# EXAMVERSE environment configuration
# Copy to .env and fill in real values. .env is git-ignored.

# ── Application ───────────────────────────────────────────────────────────
# Set to true ONLY on a local machine. In debug mode the API returns exception
# details, allows a wildcard CORS origin, and echoes dev OTPs in responses.
APP_DEBUG=false

# Signing secret for auth tokens and AI-key encryption. Minimum 32 characters.
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=examverse_db
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to deny cross-origin
# browser requests entirely (native app clients are unaffected).
CORS_ALLOWED_ORIGINS=

# ── Marketplace ───────────────────────────────────────────────────────────
# Purchases are settled by a real payment gateway. While this is false, any
# request to buy a PAID material is rejected instead of being silently marked
# as paid. Only enable with a gateway wired into MarketplaceController.
PAYMENTS_ENABLED=false
# Set true to allow the built-in mock/sandbox settlement (local testing only).
PAYMENTS_MOCK=false

# ── AI providers ──────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini

# ── External content APIs ─────────────────────────────────────────────────
# Register free keys; see SETUP.md. Never commit real values.
NEWSDATA_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=
MEDIASTACK_API_KEY=
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
GEMINI_API_KEY=

# Absolute path for uploaded creator materials. Leave empty to use
# storage/materials inside the app. Set this OUTSIDE the document root in
# production so files are never directly web-reachable.
MATERIAL_STORAGE_PATH=

# ── AI question bank top-up (cron) ────────────────────────────────────────
# Max questions inserted per nightly run.
AI_TOPUP_NIGHTLY_LIMIT=100
# Questions per provider call. Above ~15 the request exceeds the timeout.
AI_TOPUP_BATCH_SIZE=10
# Cap on how many questions may share one structural template.
AI_MAX_STRUCTURE_VARIANTS=8
# true = generated questions go live immediately; false = admin review queue.
AI_AUTO_PUBLISH=true
